# Copy outside Git, e.g. /srv/binance/deploy.env. Absolute private path required.
DATA_DIR=/srv/binance
PROJECT=binance-live
PREFIX=live
API_PORT=8080
# real is the default; smoke is accepted only by the disposable smoke command.
MODE=real

# Optional public HTTPS profile; requires Compose 2.24.4+ (!reset).
# PUBLIC_DOMAIN=alerts.example.com
# Pick an unused private /29, avoiding LAN/VPN/Docker subnets.
# INGRESS_SUBNET=172.29.75.0/29
